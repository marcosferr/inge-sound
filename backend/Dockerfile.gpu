# Imagen con CUDA. Requiere NVIDIA Container Toolkit en el host.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    TORCH_HOME=/models \
    INGE_DATA_DIR=/data

# Se usa el python3 de la distro (3.10) a propósito: el python3-pip de Ubuntu
# 22.04 apunta a 3.10, así que instalar además python3.11 dejaría torch en un
# intérprete y ejecutaría el otro.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# requirements.txt chains -r requirements-api.txt, so both must land here.
COPY requirements*.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cu121 \
        torch==2.2.2 torchaudio==2.2.2 \
    && pip install -r requirements.txt

COPY app ./app

RUN mkdir -p /data /models && useradd --create-home --uid 1000 inge \
    && chown -R inge:inge /data /models /app
USER inge

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
