# Copiá este archivo a .env y ajustá lo que necesites.
# Todas las variables del backend llevan el prefijo INGE_.

# --- Almacenamiento ---
INGE_DATA_DIR=./data
INGE_MAX_UPLOAD_MB=200
INGE_MAX_FILES_PER_JOB=10
# Horas que sobreviven los trabajos antes de borrarse solos.
INGE_RETENTION_HOURS=48
INGE_CLEANUP_INTERVAL_MINUTES=30

# --- Ejecución ---
# thread = separaciones dentro del proceso de la API (desarrollo, un solo nodo)
# celery = se encolan en Redis y las toma un worker aparte (producción, GPU)
INGE_QUEUE_BACKEND=thread
INGE_WORKER_CONCURRENCY=1
INGE_REDIS_URL=redis://localhost:6379/0
# Tope por separación, en segundos. 0 lo desactiva.
INGE_JOB_TIMEOUT_SECONDS=10800
# Dónde cachea Demucs los modelos descargados.
# INGE_TORCH_HOME=./models

# --- API ---
INGE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
# Puerto publicado por docker compose.
INGE_PORT=8080
# Base de la API para el build del frontend. Por defecto usa el mismo origen.
# VITE_API_BASE=/api
